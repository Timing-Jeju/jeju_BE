# 애플리케이션 실행용 예시입니다. 실제 비밀값을 커밋하지 마세요.
POSTGRES_DB=timing_jeju
POSTGRES_USER=timing_jeju
POSTGRES_PASSWORD=timing_jeju
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/timing_jeju
SPRING_DATASOURCE_USERNAME=timing_jeju
SPRING_DATASOURCE_PASSWORD=timing_jeju

# 로컬 Supabase 연결 예시입니다. 운영 값은 배포 플랫폼에서 주입합니다.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Spring API의 Supabase JWT 검증 설정입니다.
SPRING_PROFILES_ACTIVE=local
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# 소셜 로그인 공개 계약입니다. Spring은 Google·Kakao·Naver client secret을 읽지 않습니다.
APP_SOCIAL_LOGIN_ENABLED_PROVIDER_IDS=google,kakao,custom:naver
APP_SOCIAL_LOGIN_REDIRECT_URLS=http://127.0.0.1:3000/auth/callback

# 로컬 Supabase CLI에서 Google/Kakao를 직접 시험할 때만 .env에 값을 넣습니다.
# 실제 값은 Supabase Auth 설정 또는 비밀 관리 도구에만 보관합니다.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
SUPABASE_AUTH_EXTERNAL_KAKAO_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_KAKAO_CLIENT_SECRET=

# Naver는 Supabase Dashboard의 custom:naver provider에만 입력합니다.
# Spring API와 Compose에는 전달하지 않습니다.
NAVER_OAUTH_CLIENT_ID=
NAVER_OAUTH_CLIENT_SECRET=

# 애플리케이션 실행용 예시입니다. 실제 비밀값을 커밋하지 마세요.
POSTGRES_DB=timing_jeju
POSTGRES_USER=timing_jeju
POSTGRES_PASSWORD=timing_jeju
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/timing_jeju
SPRING_DATASOURCE_USERNAME=timing_jeju
SPRING_DATASOURCE_PASSWORD=timing_jeju

# 로컬 Supabase 연결 예시입니다. 운영 값은 배포 플랫폼에서 주입합니다.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Spring API의 Supabase JWT 검증 설정입니다.
SPRING_PROFILES_ACTIVE=local
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
API_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# 소셜 로그인 공개 계약입니다. Spring은 Google·Kakao·Naver client secret을 읽지 않습니다.
APP_SOCIAL_LOGIN_PROVIDER_IDS=google,kakao,custom:naver

# 관광지 cursor HMAC key입니다. 운영에서는 32자 이상의 무작위 비밀값을 주입합니다.
APP_PLACES_CURSOR_SIGNING_KEY=

# 여행 cursor HMAC key입니다. 운영에서는 32자 이상의 무작위 비밀값을 주입합니다.
APP_TRIPS_CURSOR_SIGNING_KEY=

# Firebase FCM은 기본 비활성이며 자격 증명 JSON 원문을 이 파일에 넣지 않습니다.
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FCM_CONNECT_TIMEOUT=2s
FCM_READ_TIMEOUT=5s
FCM_WRITE_TIMEOUT=5s
FIREBASE_CREDENTIALS_FILE=

# 완료 공급자 상태를 공개 Actuator aggregate UP/DOWN에 반영할 때만 true로 설정합니다.
# opt-in probe는 datasource connection-timeout의 영향을 받으므로 운영 probe 주기를 여유 있게 둡니다.
APP_DATA_HEALTH_ACTUATOR_ENABLED=false

# 완료 공급자 raw snapshot payload one-shot retention입니다. 기본은 비활성·dry-run입니다.
SNAPSHOT_RETENTION_ENABLED=false
SNAPSHOT_RETENTION_DRY_RUN=true
SNAPSHOT_RETENTION_BATCH_SIZE=500
# 완료 공급자 retention scheduler는 opt-in fixed-delay이며 one-shot과 동시에 켤 수 없습니다.
SNAPSHOT_RETENTION_SCHEDULE_ENABLED=false
SNAPSHOT_RETENTION_SCHEDULE_FIXED_DELAY=PT24H
SNAPSHOT_RETENTION_SCHEDULE_INITIAL_DELAY=PT1M
SNAPSHOT_RETENTION_SCHEDULE_MAX_BATCHES=10
SNAPSHOT_RETENTION_SCHEDULE_RETRY_ATTEMPTS=3
SNAPSHOT_RETENTION_SCHEDULE_INITIAL_BACKOFF=PT0.25S

# 관심 장소 backfill audit·멱등 marker cleanup입니다. local/local-hs256 외 환경은 반드시 true여야 기동됩니다.
SAVED_PLACE_RETENTION_ENABLED=false
SAVED_PLACE_RETENTION_FIXED_DELAY=PT24H
SAVED_PLACE_RETENTION_INITIAL_DELAY=PT1M
SAVED_PLACE_RETENTION_MAX_BATCHES=10

# 외부 데이터 provider 설정입니다. 사용하지 않는 provider는 false로 유지합니다.
# 실제 API key는 이 파일에 적지 않고 로컬 비추적 .env 또는 배포 환경에서 주입합니다.
# TourAPI/TAGO/KMA는 URL 인코딩 전 decoded 원문을 넣고 TMAP은 header 원문을 넣습니다.
TOUR_API_ENABLED=false
TOUR_API_API_KEY=
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_CONNECT_TIMEOUT=2s
TOUR_API_READ_TIMEOUT=5s

TAGO_ENABLED=false
TAGO_API_KEY=
TAGO_BASE_URL=https://apis.data.go.kr/1613000
TAGO_CONNECT_TIMEOUT=2s
TAGO_READ_TIMEOUT=5s

# Issue #40 DEFER: Spring TMAP은 호환용 비활성 경계이며 대중교통에 사용하지 않습니다.
TMAP_ENABLED=false
TMAP_API_KEY=
TMAP_BASE_URL=https://apis.openapi.sk.com
TMAP_CONNECT_TIMEOUT=2s
TMAP_READ_TIMEOUT=5s

# Issue #40 PoC/FastAPI 전용 on-demand key입니다. Spring은 이 값을 읽거나 전달하지 않습니다.
# 승인된 TMAP 보행·자동차 호출에만 사용하며, 없으면 live 검증은 명시적으로 SKIPPED 됩니다.
JEJU_TMAP_API_KEY=

KMA_ENABLED=false
KMA_API_KEY=
KMA_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
KMA_CONNECT_TIMEOUT=2s
KMA_READ_TIMEOUT=5s

# 앱 소유 추천 체류시간 CSV import입니다. 평소에는 반드시 false로 둡니다.
# root/file은 secret·사용자 데이터·외부 원문이 없는 운영 전용 절대 경로만 사용합니다.
STAY_POLICY_IMPORT_ENABLED=false
STAY_POLICY_IMPORT_ROOT=
STAY_POLICY_IMPORT_FILE=
STAY_POLICY_IMPORT_VERSION=
STAY_POLICY_IMPORT_EFFECTIVE_AT=
STAY_POLICY_IMPORT_EXPECTED_ACTIVE_VERSION=
STAY_POLICY_IMPORT_DRY_RUN=true

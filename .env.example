# 애플리케이션 실행용 예시입니다. 실제 비밀값을 커밋하지 마세요.
POSTGRES_DB=timing_jeju
POSTGRES_USER=timing_jeju
POSTGRES_PASSWORD=timing_jeju
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/timing_jeju
SPRING_DATASOURCE_USERNAME=timing_jeju
SPRING_DATASOURCE_PASSWORD=timing_jeju

# 로컬 Supabase 연결 예시입니다. 운영 값은 배포 플랫폼에서 주입합니다.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Spring API의 Supabase JWT 검증 설정입니다.
SPRING_PROFILES_ACTIVE=local
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# 소셜 로그인 공개 계약입니다. Spring은 Google·Kakao·Naver client secret을 읽지 않습니다.
APP_SOCIAL_LOGIN_PROVIDER_IDS=google,kakao,custom:naver

# 외부 데이터 provider 설정입니다. 사용하지 않는 provider는 false로 유지합니다.
# 실제 API key는 이 파일에 적지 않고 로컬 비추적 .env 또는 배포 환경에서 주입합니다.
# TourAPI/TAGO/KMA는 URL 인코딩 전 decoded 원문을 넣고 TMAP은 header 원문을 넣습니다.
TOUR_API_ENABLED=false
TOUR_API_API_KEY=
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_CONNECT_TIMEOUT=2s
TOUR_API_READ_TIMEOUT=5s

TAGO_ENABLED=false
TAGO_API_KEY=
TAGO_BASE_URL=https://apis.data.go.kr/1613000
TAGO_CONNECT_TIMEOUT=2s
TAGO_READ_TIMEOUT=5s

TMAP_ENABLED=false
TMAP_API_KEY=
TMAP_BASE_URL=https://apis.openapi.sk.com
TMAP_CONNECT_TIMEOUT=2s
TMAP_READ_TIMEOUT=5s

KMA_ENABLED=false
KMA_API_KEY=
KMA_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
KMA_CONNECT_TIMEOUT=2s
KMA_READ_TIMEOUT=5s

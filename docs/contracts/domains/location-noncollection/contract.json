  "server": {
    "receiveUserLocation": false,
    "storeUserLocation": false,
    "storeDerivedLocation": false,
    "locationConsentEligibility": false,
    "unknownOrigin": "reject",
    "unknownFields": "reject",
    "serviceRoleExemption": false

  "origins": {
    "allowed": [
      "explicit_selection",
      "planned_reference",
      "approved_public_source",
      "validated_location_free_input"
    ],
    "forbidden": [
      "device_gps",
      "gps_derived",
      "unknown"
    ]
  },
  "forbiddenConcepts": [
    "latitude/longitude/accuracy/altitude/heading/speed from user GPS",
    "current region/place/stop inferred from GPS",
    "GRID_100M/geohash/currentLocation/currentPlaceId/locationSupplied",
    "GPS-derived digest/hash/cache key/request fingerprint",
    "arbitrary schedule facts.location without planned public provenance",
    "raw user location in logs/metrics/traces/errors"
  ],

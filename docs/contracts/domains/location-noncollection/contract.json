{
  "schemaVersion": "timing-jeju-location-noncollection-policy/v2",
  "contractVersion": "2.0.0",
  "ownerIssue": 220,
  "supersedes": {
    "issue": 73,
    "contract": "docs/contracts/domains/location-retention/contract.json",
    "version": "1.0.0",
    "history": "immutable"

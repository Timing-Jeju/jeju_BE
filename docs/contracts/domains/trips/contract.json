  "tripPolicy": {
    "minimumDays": 1,
    "maximumDays": 30,
    "timezone": "Asia/Seoul",
    "timezoneFormat": "IANA",
    "statusEnum": ["draft", "generating", "planned", "live", "completed", "cancelled", "failed"],
    "activeScheduleVersionId": "required property; UUID or null",
    "terminalStatuses": ["completed", "cancelled", "failed"],
    "terminalMutation": "PATCH rejects completed/cancelled/failed with 409 TRIP_TERMINAL_STATE_CONFLICT; DELETE rejects only live or running async work with 409 TRIP_DELETE_CONFLICT"
  },
  "scorePolicy": {
    "totalScore": "required property; integer 0..100 or null",
    "nullRule": "scoreProvenance must be null",
    "nonNullRule": "scoreProvenance is required and references the latest succeeded feasibility run for activeScheduleVersionId",
    "source": "feasibility_run",
    "freshness": "observedAt <= calculatedAt <= expiresAt; stale is derived at response time and is true iff responseTime >= expiresAt",
    "fallback": "no successful active-schedule score returns totalScore=null and scoreProvenance=null"
  },
  "createSemantics": {
    "transaction": "trip_plans, default transport mode and one trip_days row per inclusive local date are atomic",
    "defaults": {
      "timezone": "Asia/Seoul",
      "userPace": "normal",
      "transportModes": [{"mode": "public_transit", "priority": 1, "primary": true}],
      "status": "draft",
      "activeScheduleVersionId": null,
      "totalScore": null,
      "scoreProvenance": null
    },
    "idempotency": {"header": "Idempotency-Key", "format": "canonical UUID", "ttl": "24h", "missing": "400 IDEMPOTENCY_KEY_REQUIRED", "invalid": "400 IDEMPOTENCY_KEY_INVALID", "samePayload": "replay exact original response", "differentPayload": "409 IDEMPOTENCY_KEY_REUSED", "inProgressOrReused": "409 IDEMPOTENCY_KEY_REUSED"},
    "profileProvisioningErrors": {
      "EMAIL_OWNERSHIP_CONFLICT": "409 PROFILE_CONFLICT",
      "PROVIDER_SUBJECT_CONFLICT": "409 PROFILE_CONFLICT",
      "INVALID_AUTH_IDENTITY": "503 TRIP_DATA_UNAVAILABLE",
      "STORAGE_UNAVAILABLE": "503 TRIP_DATA_UNAVAILABLE",
      "exposure": "cause-free Problem Details; no raw provider message or PII"
    }
  },
  "patchSemantics": {
    "concurrency": "required strong If-Match generated from persisted monotonically increasing revision",
    "missingIfMatch": "400 IF_MATCH_REQUIRED",
    "malformedIfMatch": "400 INVALID_IF_MATCH",
    "staleIfMatch": "409 TRIP_VERSION_CONFLICT",
    "omitted": "preserve",
    "null": "reject",
    "collections": "replace",
    "scheduleEffectMatrix": {
      "title": "maintain",
      "userPace": "invalidate-and-require-regeneration",
      "transportModes": "invalidate-and-require-regeneration",
      "startDate": "reject-with-regeneration-required-when-any-schedule-version-exists",
      "endDate": "reject-with-regeneration-required-when-any-schedule-version-exists",
      "timezone": "reject-with-regeneration-required-when-any-schedule-version-exists"
    },
    "maintain": "title-only keeps status and activeScheduleVersionId; scheduleEffect=maintained, regenerationRequired=false",
    "invalidate": "userPace or transportModes supersedes active version, clears activeScheduleVersionId, sets status=draft, scheduleEffect=invalidated and regenerationRequired=true in one transaction",
    "regenerationRequired": "date/timezone change with any schedule version is rejected 409 without mutation; without schedule versions dates and trip_days are rebuilt atomically",
    "datePair": "when either startDate or endDate is omitted validation uses the persisted counterpart",
    "terminal": "completed/cancelled/failed reject all PATCH operations"
  },
  "deleteSemantics": {
    "success": "204 with no body",
    "repeat": "404 TRIP_NOT_FOUND",
    "crossOwner": "404 TRIP_NOT_FOUND",
    "terminalOrRunning": "409 TRIP_DELETE_CONFLICT while an async run is running or trip status is live",
    "tripAggregate": "cascade",
    "aggregateTableScope": "all persisted trip-owned direct and transitive ON DELETE CASCADE children",
    "aggregateTables": ["trip_preferences", "trip_transport_modes", "trip_place_preferences", "trip_transport_events", "trip_accommodations", "trip_days", "trip_schedule_versions", "trip_items", "trip_legs", "itinerary_generation_runs", "itinerary_generation_candidates", "schedule_revision_runs", "compute_runs", "compute_run_inputs", "risk_events", "trip_weather_impacts", "recommendation_candidates", "recovery_options", "recovery_option_changes", "trip_item_progress", "trip_execution_events", "live_state_snapshots", "ai_conversations", "ai_messages", "mcp_compute_call_logs"],
    "locationAndExecutionHistory": "delete-with-aggregate",
    "externalImportLineage": "preserve",
    "userAndAuthIdentity": "preserve",
    "externalNormalizedFacts": "preserve; trip deletion never deletes tour_places, transport/weather normalized rows, snapshots or data_import_runs"
  },

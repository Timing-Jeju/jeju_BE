  "projectionPolicy": {
    "reviewAdditionalProperties": false,
    "serverIdentifiersOutsideReview": ["candidateId", "scheduleVersionId", "rank", "strategy", "evaluationStatus"],
    "timeFormat": "H:MM",
    "distanceFormat": "meters below 1000; one-decimal kilometers at or above 1000",
    "successfulLegNumericEvidenceRequired": ["startTime", "endTime", "cost", "distanceText"],
    "slackUnknownSentinel": {"value": 0, "status": "warning", "reason": "여유시간 근거 확인 불가"},
    "busColorEvidence": false,
    "busColorProjection": ["green", "blue", "sky", "red"],
    "alternativeModes": ["bus", "taxi"],
    "forbiddenRequestFields": ["original_text", "gps", "time", "cost", "distance", "risk", "geometry"]
  },
  "schemas": {
    "Coord": {"type": "object", "nullable": false, "additionalProperties": false, "required": ["latitude", "longitude"], "properties": {"latitude": {"type": "number", "nullable": false, "minimum": -90, "maximum": 90}, "longitude": {"type": "number", "nullable": false, "minimum": -180, "maximum": 180}}},
    "DayTime": {"type": "object", "nullable": false, "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "string", "nullable": false, "pattern": "^(?:[01]?\\d|2[0-3]):[0-5]\\d$"}, "end": {"type": "string", "nullable": false, "pattern": "^(?:[01]?\\d|2[0-3]):[0-5]\\d$"}}},
    "TripLodging": {"type": "object", "nullable": false, "additionalProperties": false, "required": ["name", "address", "coord"], "properties": {"name": {"type": "string", "nullable": false}, "address": {"type": "string", "nullable": false}, "coord": {"$ref": "Coord", "nullable": true}}},
    "TripConditions": {"type": "object", "nullable": false, "additionalProperties": false, "required": ["startDate", "endDate", "arrivalTransport", "arrivalTime", "departureTransport", "departureTime", "dayTimes", "lodgingMode", "lodging", "dailyLodgings", "styles", "transport"], "properties": {"startDate": {"type": "string", "nullable": true, "format": "date"}, "endDate": {"type": "string", "nullable": true, "format": "date"}, "arrivalTransport": {"type": "string", "nullable": true, "enum": ["비행기", "선박"]}, "arrivalTime": {"type": "string", "nullable": true, "pattern": "^(?:[01]?\\d|2[0-3]):[0-5]\\d$"}, "departureTransport": {"type": "string", "nullable": true, "enum": ["비행기", "선박"]}, "departureTime": {"type": "string", "nullable": true, "pattern": "^(?:[01]?\\d|2[0-3]):[0-5]\\d$"}, "dayTimes": {"type": "object", "nullable": false, "additionalProperties": {"$ref": "DayTime"}}, "lodgingMode": {"type": "string", "nullable": true, "enum": ["single", "daily"]}, "lodging": {"$ref": "TripLodging", "nullable": true}, "dailyLodgings": {"type": "object", "nullable": false, "additionalProperties": {"$ref": "TripLodging"}}, "styles": {"type": "array", "nullable": false, "items": {"type": "string", "nullable": false}}, "transport": {"type": "array", "nullable": false, "items": {"type": "string", "nullable": false, "enum": ["bus", "taxi", "walk"]}}}},
    "SchedulePlace": {"type": "object", "nullable": false, "additionalProperties": false, "required": ["name", "category", "address", "visitType", "stayMinutes", "coord"], "properties": {"name": {"type": "string", "nullable": false}, "category": {"type": "string", "nullable": false}, "address": {"type": "string", "nullable": false}, "visitType": {"type": "string", "nullable": true, "enum": ["필수방문", "선택방문"]}, "stayMinutes": {"type": "integer", "nullable": false, "minimum": 0}, "coord": {"$ref": "Coord", "nullable": true}}},
    "FavoritePlace": {"type": "object", "nullable": false, "additionalProperties": false, "required": ["name", "category", "address", "visitType", "memo", "stayMinutes", "direction", "coord"], "properties": {"name": {"type": "string", "nullable": false}, "category": {"type": "string", "nullable": false}, "address": {"type": "string", "nullable": false}, "visitType": {"type": "string", "nullable": false, "enum": ["필수방문", "선택방문"]}, "memo": {"type": "string", "nullable": false}, "stayMinutes": {"type": "integer", "nullable": false, "minimum": 0}, "direction": {"type": "string", "nullable": false}, "coord": {"$ref": "Coord", "nullable": true}}},
    "RouteBus": {"type": "object", "nullable": false, "additionalProperties": false, "required": ["text", "color"], "properties": {"text": {"type": "string", "nullable": false}, "color": {"type": "string", "nullable": false, "enum": ["green", "blue", "sky", "red", "grey"]}}},
    "RouteStep": {"type": "object", "nullable": false, "additionalProperties": false, "required": ["kind", "name", "detail", "buses", "caution"], "properties": {"kind": {"type": "string", "nullable": false, "enum": ["place", "stop"]}, "name": {"type": "string", "nullable": false}, "detail": {"type": "string", "nullable": true}, "buses": {"type": "array", "nullable": false, "items": {"$ref": "RouteBus"}}, "caution": {"type": "boolean", "nullable": false}}},
    "RouteLeg": {"type": "object", "nullable": false, "additionalProperties": false, "required": ["id", "from", "to", "fromCoord", "toCoord", "status", "startTime", "endTime", "cost", "distanceText", "reason", "steps", "departStayMinutes", "slackMinutes", "buses"], "properties": {"id": {"type": "string", "nullable": false}, "from": {"type": "string", "nullable": false}, "to": {"type": "string", "nullable": false}, "fromCoord": {"$ref": "Coord", "nullable": true}, "toCoord": {"$ref": "Coord", "nullable": true}, "status": {"type": "string", "nullable": false, "enum": ["positive", "cautionary", "warning"]}, "startTime": {"type": "string", "nullable": false, "pattern": "^(?:[01]?\\d|2[0-3]):[0-5]\\d$"}, "endTime": {"type": "string", "nullable": false, "pattern": "^(?:[01]?\\d|2[0-3]):[0-5]\\d$"}, "cost": {"type": "integer", "nullable": false, "minimum": 0}, "distanceText": {"type": "string", "nullable": false, "pattern": "^(?:\\d+m|\\d+\\.\\dkm)$"}, "reason": {"type": "string", "nullable": true}, "steps": {"type": "array", "nullable": false, "items": {"$ref": "RouteStep"}}, "departStayMinutes": {"type": "integer", "nullable": false, "minimum": 0}, "slackMinutes": {"type": "integer", "nullable": false}, "buses": {"type": "array", "nullable": false, "items": {"$ref": "RouteBus"}}}},
    "DayReview": {"type": "object", "nullable": false, "additionalProperties": false, "required": ["mode", "summary", "legs", "dirty", "confirmed"], "properties": {"mode": {"type": "string", "nullable": false, "enum": ["manual", "ai"]}, "summary": {"type": "string", "nullable": false}, "legs": {"type": "array", "nullable": false, "items": {"$ref": "RouteLeg"}}, "dirty": {"type": "boolean", "nullable": false}, "confirmed": {"type": "boolean", "nullable": false}}},
    "FillSuggestion": {"type": "object", "nullable": false, "additionalProperties": false, "required": ["id", "name", "transportLabel", "startTime", "endTime", "distanceText"], "properties": {"id": {"type": "string", "nullable": false}, "name": {"type": "string", "nullable": false}, "transportLabel": {"type": "string", "nullable": false, "enum": ["도보", "버스"]}, "startTime": {"type": "string", "nullable": false, "pattern": "^(?:[01]?\\d|2[0-3]):[0-5]\\d$"}, "endTime": {"type": "string", "nullable": false, "pattern": "^(?:[01]?\\d|2[0-3]):[0-5]\\d$"}, "distanceText": {"type": "string", "nullable": false, "pattern": "^(?:\\d+m|\\d+\\.\\dkm)$"}}},
    "RouteAlternative": {"type": "object", "nullable": false, "additionalProperties": false, "required": ["id", "from", "to", "bus", "startTime", "endTime", "cost", "note"], "properties": {"id": {"type": "string", "nullable": false}, "from": {"type": "string", "nullable": false}, "to": {"type": "string", "nullable": false}, "bus": {"$ref": "RouteBus", "nullable": true}, "startTime": {"type": "string", "nullable": false, "pattern": "^(?:[01]?\\d|2[0-3]):[0-5]\\d$"}, "endTime": {"type": "string", "nullable": false, "pattern": "^(?:[01]?\\d|2[0-3]):[0-5]\\d$"}, "cost": {"type": "integer", "nullable": false, "minimum": 0}, "note": {"type": "string", "nullable": false}}},
    "SelectedCandidate": {"type": "object", "nullable": false, "additionalProperties": false, "required": ["candidateId", "scheduleVersionId", "rank", "strategy", "evaluationStatus", "review"], "properties": {"candidateId": {"type": "string", "nullable": false, "format": "uuid"}, "scheduleVersionId": {"type": "string", "nullable": false, "format": "uuid"}, "rank": {"type": "integer", "nullable": false, "enum": [1]}, "strategy": {"type": "string", "nullable": false, "enum": ["balanced"]}, "evaluationStatus": {"type": "string", "nullable": false, "enum": ["feasible", "feasible_with_caution"]}, "review": {"$ref": "DayReview", "nullable": false}}}
  },

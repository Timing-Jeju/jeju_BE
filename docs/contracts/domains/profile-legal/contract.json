        "nextRetryAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "nullable": true
        }
      }
    },
    "DeletionStatus": {
      "type": "string",
      "nullable": false,
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "ProblemDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title",
        "status",
        "detail",
        "instance",
        "code",
        "traceId",
        "fieldErrors"
      ],
      "properties": {
        "type": {
          "type": "string",
          "nullable": false,
          "minLength": 1,
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "nullable": false,
          "minLength": 1,
          "maxLength": 100
        },
        "status": {
          "type": "integer",
          "nullable": false,
          "minimum": 400,
          "maximum": 599
        },
        "detail": {
          "type": "string",
          "nullable": false,
          "minLength": 1,
          "maxLength": 500
        },
        "instance": {
          "type": "string",
          "nullable": false,
          "minLength": 1,
          "maxLength": 200
        },
        "code": {
          "type": "string",
          "nullable": false,
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "traceId": {
          "type": "string",
          "nullable": false,
          "pattern": "^[0-9a-f]{32}$"
        },
        "fieldErrors": {
          "type": "array",
          "nullable": false,
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "string",
            "nullable": false,
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    }

  "schemas": {
    "CommonHeaders": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Authorization"
      ],
      "properties": {
        "Authorization": {
          "type": "string",
          "nullable": false,
          "pattern": "^Bearer [A-Za-z0-9._~-]{16,4096}$"
        }
      }
    },
    "OptionalAuthorizationHeaders": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "Authorization": {
          "type": "string",
          "nullable": false,
          "pattern": "^Bearer [A-Za-z0-9._~-]{16,4096}$"
        }
      }
    },
    "ProfileResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "email",
        "nickname",
        "profileImageUrl",
        "locale",
        "providers",
        "onboardingCompleted",
        "updatedAt"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "format": "uuid",
          "nullable": false
        },
        "email": {
          "type": "string",
          "nullable": true,
          "readOnly": true,
          "minLength": 3,
          "maxLength": 254
        },
        "nickname": {
          "type": "string",
          "nullable": true,
          "minLength": 1,
          "maxLength": 50
        },
        "profileImageUrl": {
          "type": "string",
          "nullable": true,
          "readOnly": true,
          "minLength": 1,
          "maxLength": 512
        },
        "locale": {
          "type": "string",
          "nullable": false,
          "enum": [
            "ko-KR"
          ]
        },
        "providers": {
          "type": "array",
          "nullable": false,
          "readOnly": true,
          "minItems": 0,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "nullable": false,
            "enum": [
              "google",
              "kakao",
              "custom:naver"
            ]
          }
        },
        "onboardingCompleted": {
          "type": "boolean",
          "nullable": false
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "nullable": false
        }
      }
    },
    "ProfilePatchRequest": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "nickname": {
          "type": "string",
          "nullable": false,
          "minLength": 1,
          "maxLength": 50
        },
        "locale": {
          "type": "string",
          "nullable": false,
          "enum": [
            "ko-KR"
          ]
        }
      }
    },
    "DeleteAccountRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmation"
      ],
      "properties": {
        "confirmation": {
          "type": "string",
          "nullable": false,
          "enum": [
            "DELETE_MY_ACCOUNT"
          ]
        }
      }
    },
    "DeleteAccountHeaders": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Authorization",
        "Idempotency-Key"
      ],
      "properties": {
        "Authorization": {
          "type": "string",
          "nullable": false,
          "pattern": "^Bearer [A-Za-z0-9._~-]{16,4096}$"
        },
        "Idempotency-Key": {
          "type": "string",
          "format": "uuid",
          "nullable": false
        }
      }
    },
    "DeleteAcceptedResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deletionRequestId",
        "statusToken",
        "statusTokenExpiresAt",
        "pollUrl",
        "requestedAt"
      ],
      "properties": {
        "deletionRequestId": {
          "type": "string",
          "nullable": false,
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "statusToken": {
          "type": "string",
          "nullable": false,
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "statusTokenExpiresAt": {
          "type": "string",
          "format": "date-time",
          "nullable": false
        },
        "pollUrl": {
          "type": "string",
          "nullable": false,
          "pattern": "^/api/v1/account-deletion-requests/[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "requestedAt": {
          "type": "string",
          "format": "date-time",
          "nullable": false
        }
      }
    },
    "LegalDocumentsQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "locale": {
          "type": "string",
          "nullable": false,
          "enum": [
            "ko-KR"
          ]
        }
      }
    },
    "LegalDocumentsResponse": {
      "type": "object",
      "additionalProperties": false,

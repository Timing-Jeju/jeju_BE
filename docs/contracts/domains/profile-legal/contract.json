                "nullable": false,
                "minLength": 1,
                "maxLength": 100
              },
              "contentUrl": {
                "type": "string",
                "nullable": false,
                "pattern": "^https://[A-Za-z0-9._~:/?#\\[\\]@!$&'()*+,;=%-]{1,2040}$"

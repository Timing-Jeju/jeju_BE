        "locale",
        "items"
      ],
      "properties": {
        "evaluatedAt": {
          "type": "string",
          "format": "date-time",
          "nullable": false
        },
        "locale": {
          "type": "string",
          "nullable": false,
          "enum": [
            "ko-KR"
          ]
        },
        "items": {
          "type": "array",
          "nullable": false,
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "documentId",
              "type",
              "version",
              "title",
              "contentUrl",
              "required",
              "effectiveAt"
            ],
            "properties": {
              "documentId": {
                "type": "string",
                "format": "uuid",
                "nullable": false
              },
              "type": {

  "endpoints": [
    {
      "method": "GET",
      "path": "/api/v1/places",
      "operation": "list",
      "requestSchema": "PlacesListRequest",
      "successSchema": "PlacesListResponse",
      "auth": {
        "mode": "optional",
        "missingToken": "anonymous",
        "invalidToken": 401
      },
      "query": {
        "query": {
          "required": false,
          "nullable": false,
          "omitted": "전체 이름/별칭",
          "type": "trimmed string",
          "minimumLength": 1,
          "maximumLength": 100
        },
        "category": {
          "required": false,
          "nullable": false,
          "omitted": "모든 카테고리",
          "pattern": "^[a-z][a-z0-9_]{0,49}$"
        },
        "regionCode": {
          "required": false,
          "nullable": false,
          "omitted": "모든 제주 지역",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,49}$"
        },
        "lat": {
          "required": false,
          "nullable": false,
          "minimum": 33,
          "maximum": 34,
          "pairedWith": "lng"
        },
        "lng": {
          "required": false,
          "nullable": false,
          "minimum": 126,
          "maximum": 127,
          "pairedWith": "lat"
        },
        "radiusMeters": {
          "required": false,
          "nullable": false,
          "minimum": 100,
          "maximum": 50000,
          "default": 10000,
          "requires": [
            "lat",
            "lng"
          ]
        },
        "cursor": {
          "required": false,
          "nullable": false,
          "type": "opaque string",
          "maximumLength": 2048
        },
        "size": {
          "required": false,
          "nullable": false,
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "savedOnly": {
          "required": false,
          "nullable": false,
          "type": "boolean",
          "default": false
        }
      },
      "pagination": {
        "type": "cursor",
        "cursor": "opaque",
        "size": {
          "default": 20,
          "max": 100
        },
        "stableSort": {
          "nearby": [
            "distanceMeters ASC NULLS LAST",
            "normalizedName ASC",
            "placeId ASC"
          ],
          "default": [
            "normalizedName ASC",
            "placeId ASC"
          ]
        },
        "tieBreaker": "placeId ASC",
        "cursorScope": [
          "query",
          "category",
          "regionCode",
          "lat",
          "lng",
          "radiusMeters",
          "size",
          "savedOnly",
          "sortProfile"
        ],
        "filterChange": "reject CURSOR_CONTEXT_MISMATCH"
      },
      "successStatus": 200,
      "problems": [
        {"condition": "query parameter type/range/pattern invalid", "status": 400, "code": "INVALID_QUERY_PARAMETER", "type": "https://api.timing-jeju.com/problems/invalid-query-parameter"},
        {"condition": "lat/lng pair missing or radius without coordinates", "status": 400, "code": "INVALID_GEO_FILTER", "type": "https://api.timing-jeju.com/problems/invalid-geo-filter"},
        {"condition": "cursor filter scope differs", "status": 400, "code": "CURSOR_CONTEXT_MISMATCH", "type": "https://api.timing-jeju.com/problems/cursor-context-mismatch"},
        {"condition": "cursor malformed or unverifiable", "status": 400, "code": "INVALID_CURSOR", "type": "https://api.timing-jeju.com/problems/invalid-cursor"},
        {"condition": "optional bearer token supplied but invalid", "status": 401, "code": "INVALID_ACCESS_TOKEN", "type": "https://api.timing-jeju.com/problems/invalid-access-token"},
        {"condition": "valid query combination cannot be processed", "status": 422, "code": "PLACE_QUERY_CONSTRAINT_VIOLATION", "type": "https://api.timing-jeju.com/problems/place-query-constraint-violation"},
        {"condition": "normalized upstream refresh rate limited", "status": 429, "code": "UPSTREAM_RATE_LIMITED", "type": "https://api.timing-jeju.com/problems/upstream-rate-limited"},
        {"condition": "safe normalized place data unavailable", "status": 503, "code": "PLACE_DATA_UNAVAILABLE", "type": "https://api.timing-jeju.com/problems/place-data-unavailable"}
      ]
    },
    {
      "method": "GET",
      "path": "/api/v1/places/{placeId}",
      "operation": "read",
      "requestSchema": "PlaceDetailPath",
      "successSchema": "PlaceDetailResponse",
      "auth": {
        "mode": "optional",
        "missingToken": "anonymous",
        "invalidToken": 401
      },
      "pathParameters": {
        "placeId": {
          "required": true,
          "nullable": false,
          "type": "canonical UUID"
        }
      },
      "successStatus": 200,
      "problems": [
        {"condition": "placeId is not canonical UUID", "status": 400, "code": "INVALID_QUERY_PARAMETER", "type": "https://api.timing-jeju.com/problems/invalid-query-parameter"},
        {"condition": "optional bearer token supplied but invalid", "status": 401, "code": "INVALID_ACCESS_TOKEN", "type": "https://api.timing-jeju.com/problems/invalid-access-token"},
        {"condition": "place does not exist or is not publicly readable", "status": 404, "code": "PLACE_NOT_FOUND", "type": "https://api.timing-jeju.com/problems/place-not-found"},
        {"condition": "safe normalized place detail unavailable", "status": 503, "code": "PLACE_DATA_UNAVAILABLE", "type": "https://api.timing-jeju.com/problems/place-data-unavailable"}
      ]
    }
  ],

      "properties": {
        "placeId": {"type": "string", "nullable": false, "format": "uuid"},
        "contentId": {"type": "string", "nullable": false, "minLength": 1, "maxLength": 100},
        "name": {"type": "string", "nullable": false, "minLength": 1, "maxLength": 200},
        "category": {"type": "string", "nullable": false, "pattern": "^[a-z][a-z0-9_]{0,49}$"},

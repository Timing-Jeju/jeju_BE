      "provider": "TIMING_JEJU",
      "observedAt": "saved_places.updated_at",
      "expiresAt": null,
      "stale": false
    },
    "nearbyStops": {
      "owner": "TAGO stop + Timing Jeju place-stop link",
      "provider": "place_stop_links.source_provider",
      "observedAt": "place_stop_links.observed_at",
      "expiresAt": "least(place_stop_links.expires_at, non-null bus_stops.stale_at)",
      "stale": "effective expiresAt <= now()"
    }
  },

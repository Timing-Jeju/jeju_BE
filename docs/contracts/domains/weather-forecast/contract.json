{
  "schemaVersion": "timing-jeju-weather-forecast-contract/v1",
  "contractVersion": "2.0.0",
  "sourceSpecVersion": "2.0.0",
  "inherits": "timing-jeju-rest-contract/v1",
  "ownerIssue": 94,
  "implementationIssues": [222],
  "schemas": {
    "WeatherForecastQuery": {
      "type": "object",
      "nullable": false,
      "additionalProperties": false,
      "required": [
        "dateTime"
      ],
      "properties": {
        "regionCode": {
          "type": "string",
          "nullable": false,
          "minLength": 1,
          "maxLength": 50,
          "pattern": "^[a-z0-9][a-z0-9_-]{0,49}$"
        },
        "placeId": {
          "type": "string",
          "nullable": false,
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "tripItemId": {
          "type": "string",
          "nullable": false,
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "dateTime": {
          "type": "string",
          "nullable": false,
          "format": "date-time",
          "timezone": "Asia/Seoul",
          "requiredOffset": "+09:00",
          "seconds": 0
        }
      },
      "oneOf": [
        {
          "required": [
            "regionCode"
          ]
        },
        {
          "required": [
            "placeId"
          ]
        },
        {
          "required": [
            "tripItemId"
          ]
        }
      ]
    },
    "CommonHeaders": {
      "type": "object",
      "nullable": false,
      "additionalProperties": false,
      "required": [],
      "properties": {
        "Authorization": {"type": "string", "nullable": false, "pattern": "^Bearer [^\\s]{1,2048}$"}
      }
    },
    "WeatherGrid": {
      "type": "object",
      "nullable": false,
      "additionalProperties": false,
      "required": ["nx", "ny", "regionName"],
      "properties": {
        "nx": {"type": "integer", "nullable": false, "minimum": 1, "maximum": 149},
        "ny": {"type": "integer", "nullable": false, "minimum": 1, "maximum": 253},
        "regionName": {"type": "string", "nullable": true, "minLength": 1, "maxLength": 100}
      }
    },
    "WeatherForecastResponse": {
      "type": "object",
      "nullable": false,
      "additionalProperties": false,
      "required": ["contractVersion", "grid", "provider", "providerApiVersion", "forecastType", "baseDate", "baseTime", "forecastedAt", "validAt", "temperatureC", "precipitationProbabilityPercent", "precipitationAmountMm", "precipitationType", "skyCode", "humidityPercent", "windSpeedMps", "observedAt", "expiresAt", "stale", "fallbackUsed"],
      "properties": {
        "contractVersion": {"type": "string", "nullable": false, "const": "2.0.0"},
        "grid": {"$ref": "WeatherGrid"},
        "provider": {"type": "string", "nullable": false, "const": "KMA"},
        "providerApiVersion": {"type": "string", "nullable": false, "const": "VilageFcstInfoService_2.0"},
        "forecastType": {"type": "string", "nullable": false, "enum": ["ultra_short", "village"]},
        "baseDate": {"type": "string", "nullable": false, "format": "date"},
        "baseTime": {"type": "string", "nullable": false, "pattern": "^(?:[01]\\d|2[0-3]):(?:00|30)$"},
        "forecastedAt": {"type": "string", "nullable": false, "format": "date-time", "offset": "+09:00"},
        "validAt": {"type": "string", "nullable": false, "format": "date-time", "offset": "+09:00"},
        "temperatureC": {"type": "number", "nullable": true, "minimum": -100, "maximum": 100},
        "precipitationProbabilityPercent": {"type": "integer", "nullable": true, "minimum": 0, "maximum": 100},
        "precipitationAmountMm": {"type": "number", "nullable": true, "minimum": 0},
        "precipitationType": {"type": "string", "nullable": true, "enum": ["none", "rain", "rain_snow", "snow", "shower", "raindrop", "raindrop_snowflake", "snowflake"]},
        "skyCode": {"type": "string", "nullable": true, "enum": ["clear", "mostly_cloudy", "cloudy"]},
        "humidityPercent": {"type": "integer", "nullable": true, "minimum": 0, "maximum": 100},
        "windSpeedMps": {"type": "number", "nullable": true, "minimum": 0},
        "observedAt": {"type": "string", "nullable": false, "format": "date-time", "offset": "+09:00"},
        "expiresAt": {"type": "string", "nullable": false, "format": "date-time", "offset": "+09:00"},
        "stale": {"type": "boolean", "nullable": false},
        "fallbackUsed": {"type": "boolean", "nullable": false}
      }
    }
  },
  "endpoints": [
    {
      "method": "GET",
      "path": "/api/v1/weather/forecast",
      "operation": "read",
      "requestSchema": "WeatherForecastQuery",
      "headersSchema": "CommonHeaders",
      "successSchema": "WeatherForecastResponse",
      "auth": {"mode": "optional", "missingToken": "anonymous", "invalidToken": 401},
      "owner": "regionCode/placeId: public explicit selection; tripItemId: authenticated canonical JWT sub owner only",
      "presence": "exactly one of regionCode/placeId/tripItemId and dateTime required; GPS-derived selectors forbidden; tripItemId requires bearer and owner lookup",
      "responses": {"success": [200], "errors": [400, 401, 404, 422, 503]},
      "errorMatrix": {
        "400": [
          "INVALID_WEATHER_SELECTOR"
        ],
        "401": [
          "AUTHENTICATION_REQUIRED",
          "INVALID_ACCESS_TOKEN"
        ],
        "422": [
          "WEATHER_LOCATION_NOT_SUPPORTED",
          "WEATHER_FORECAST_HORIZON_NOT_SUPPORTED"
        ],
        "503": [
          "WEATHER_FORECAST_UNAVAILABLE"
        ],
        "404": [
          "WEATHER_REFERENCE_NOT_FOUND"
        ]
      },
      "idempotency": {"required": false, "header": "none"},
      "pagination": {"type": "none"},
      "dbOwner": "Spring read-only public region/place/planned item to weather grid; implementation #222",
      "requestTimeCall": "none; request reads normalized stored forecast and never calls KMA or private MCP",
      "dataLineage": "KMA versioned snapshot -> import run -> normalized weather_forecasts; raw provider payload is never projected",
      "figma": {"node": "1291:8816", "action": "1291:8819", "loading": "1291:8820", "empty": "1291:8822", "error": "1291:8823"},
      "contractVersion": "2.0.0"
    }
  ],
  "gridPolicy": {
    "projection": "KMA DFS 5km Lambert conformal conic",
    "rounding": "floor(projectedCoordinate + 0.5)",
    "nx": {
      "minimum": 1,
      "maximum": 149
    },
    "ny": {
      "minimum": 1,
      "maximum": 253
    },
    "outOfGrid": "422 WEATHER_LOCATION_NOT_SUPPORTED",
    "selectorResolution": {
      "regionCode": "explicit public region representative grid",
      "placeId": "explicit canonical public place grid",
      "tripItemId": "owner-checked planned item public anchor grid",
      "missingReference": "404 WEATHER_REFERENCE_NOT_FOUND",
      "gpsDerived": "forbidden"
    }
  },
  "forecastPolicy": {
    "timezone": "Asia/Seoul",
    "queryGranularity": "whole hour; seconds must be 00",
    "referenceTime": "Spring request acceptance time truncated down to the hour in Asia/Seoul",
    "ultraShortHorizon": "0 through 6 hours inclusive",
    "villageHorizon": "over 6 hours through 10 days inclusive",
    "outsideHorizon": "422 WEATHER_FORECAST_HORIZON_NOT_SUPPORTED",
    "providerApiVersion": "VilageFcstInfoService_2.0",
    "providerGuideVersion": "2607",
    "storageTypeToResponseType": {"ultra_short": "ultra_short", "short": "village"},
    "baseSelection": "latest eligible base whose publication delay elapsed",
    "ultraShortBases": "hourly at HH:30; eligible after 15 minutes",
    "villageBases": "02:00,05:00,08:00,11:00,14:00,17:00,20:00,23:00; eligible after 10 minutes",
    "validAtRule": "returned validAt exactly equals requested dateTime"
  },
  "categoryPolicy": {
    "responseFields": ["temperatureC", "precipitationProbabilityPercent", "precipitationAmountMm", "precipitationType", "skyCode", "humidityPercent", "windSpeedMps"],
    "mapping": {"TMP/T1H": "temperatureC", "POP": "precipitationProbabilityPercent", "PCP/RN1": "precipitationAmountMm", "PTY": "precipitationType", "SKY": "skyCode", "REH": "humidityPercent", "WSD": "windSpeedMps"},
    "unavailable": "explicit null",
    "omitted": "forbidden",
    "rawCategory": "not exposed",
    "invalidAggregate": "missing a category required by the selected provider operation makes that base unusable and invokes the one-base fallback"
  },
  "freshnessPolicy": {
    "observedAt": "snapshot fetched_at for the normalized selected row",
    "expiresAt": "observedAt plus selected operation TTL",
    "evaluatedAt": "response assembly time",
    "staleRule": "stale = evaluatedAt >= expiresAt",
    "freshSuccess": "fallbackUsed=false; stale follows staleRule",
    "fallbackLimit": "exactly one immediately previous eligible base",
    "fallbackSuccess": "fallbackUsed=true and stale=true",
    "fallbackExhausted": "503 WEATHER_FORECAST_UNAVAILABLE",
    "ttl": {"ultra_short": "10 minutes", "village": "same eligible base until the next base becomes eligible"}
  },
  "securityPolicy": {
    "principal": "canonical JWT sub only; tripItemId ownership required; never location-derived identity",
    "forbiddenAuthorityInputs": ["user_metadata", "email", "provider payload", "raw token", "GPS-derived regionCode/placeId/stopId"],
    "forbiddenPersistence": ["request precise coordinates", "request query", "raw provider payload in public response"],
    "forbiddenLogging": ["precise coordinates", "raw token", "service key", "provider query", "provider payload"],
    "fastApiBoundary": "FastAPI does not expose this endpoint, access DB, receive JWT, or receive provider credentials"
  },

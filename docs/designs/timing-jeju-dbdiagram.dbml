  origin_location geography [not null]
  destination_location geography [not null]
  transport_mode text [not null]
  departure_at timestamptz
  distance_meters integer
  duration_minutes integer [not null]
  estimated_fare integer
  source_provider text [not null]
  source_operation text [not null]
  route_summary jsonb [not null]
  observed_at timestamptz [not null]
  expires_at timestamptz [not null]
  raw_payload jsonb [not null]
  source_snapshot_id uuid [ref: > external_api_snapshots.id]
  import_run_id uuid [ref: > data_import_runs.id]

  indexes {
    (source_provider, source_operation, request_hash, observed_at) [unique]
  }
}

Table trip_plans {
  id uuid [pk]
  user_id uuid [ref: > user_profiles.id]
  session_id uuid [ref: > app_sessions.id]
  public_token text [not null, unique]
  title text
  status text [not null]
  input_text text
  start_date date [not null]
  end_date date [not null]
  user_pace text [not null]
  total_score integer
  source_mode text [not null]
  data_version text [not null]
  stale boolean [not null]
  active_schedule_version_id uuid [ref: > trip_schedule_versions.id]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  trip_ended_at timestamptz [note: "DB-recorded one-shot timestamp on first completed transition; immutable"]
  expires_at timestamptz

  Note: "candidate 또는 active 일정 버전이 존재하면 start_date와 end_date를 변경할 수 없다."
}

Table trip_preferences {
  trip_plan_id uuid [pk, ref: > trip_plans.id]
  preferred_categories text[] [not null]
  arrival_region_code text
  departure_region_code text
  preferred_region_codes text[] [not null]
  start_place_id uuid [ref: > tour_places.id]
  end_place_id uuid [ref: > tour_places.id]
  raw_answers jsonb [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table trip_transport_modes {
  trip_plan_id uuid [pk, ref: > trip_plans.id]
  transport_mode text [pk, note: "public_transit, rental_car, taxi"]
  priority smallint [not null]
  is_primary boolean [not null]
  created_at timestamptz [not null]

  indexes {
    (trip_plan_id, priority) [unique]
  }
}

Table trip_place_preferences {
  trip_plan_id uuid [pk, ref: > trip_plans.id]
  place_id uuid [pk, ref: > tour_places.id]
  preference_type text [pk]
  target_day_no integer
  priority integer [not null]
  source text [not null]
  created_at timestamptz [not null]
}

Table trip_transport_events {
  id uuid [pk]
  trip_plan_id uuid [not null, ref: > trip_plans.id]
  event_type text [not null, note: "arrival or departure"]
  transport_type text [not null, note: "flight or ferry"]
  terminal_place_id uuid [ref: > tour_places.id]
  terminal_name text
  scheduled_at timestamptz [not null]
  transport_number text
  source text [not null]
  note text
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (trip_plan_id, event_type) [unique]
  }
}

Table trip_accommodations {
  id uuid [pk]
  trip_plan_id uuid [not null, ref: > trip_plans.id]
  place_id uuid [ref: > tour_places.id]
  custom_name text
  check_in_date date [not null]
  check_out_date date [not null]
  check_in_time time
  check_out_time time
  address_text text
  sequence_no integer [not null]
  source text [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (trip_plan_id, sequence_no) [unique]
  }

  Note: "Date ranges cannot overlap within the same trip (PostgreSQL GiST exclusion constraint)."
}

Table trip_days {
  id uuid [pk]
  trip_plan_id uuid [not null, ref: > trip_plans.id]
  day_no integer [not null]
  trip_date date [not null]
  start_time time
  end_time time
  title text
  safety_score integer
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (trip_plan_id, day_no) [unique]
    (trip_plan_id, trip_date) [unique]
    (id, trip_plan_id) [unique]
  }

  Note: "candidate/active가 하나라도 있으면 Day 추가·삭제 및 day_no/trip_date/start_time/end_time 변경을 금지하고 봉인과 같은 trip_plan mutex를 공유한다."
}

Table trip_schedule_versions {
  id uuid [pk]
  trip_plan_id uuid [not null, ref: > trip_plans.id]
  version_no integer [not null]
  base_schedule_version_id uuid [ref: > trip_schedule_versions.id]
  status text [not null, note: "draft, candidate, active, superseded, rejected; candidate/active requires complete located/timed items and every consecutive leg"]
  source_type text [not null]
  summary text
  resulting_score integer
  created_by_user_id uuid [ref: > user_profiles.id]
  created_at timestamptz [not null]
  applied_at timestamptz

  indexes {
    (trip_plan_id, version_no) [unique]
    (id, trip_plan_id) [unique]
  }

  Note: "version_no는 생성 후 불변이며 base_schedule_version_id는 같은 여행의 더 작은 번호만 참조한다. candidate/active 봉인 시 항목 시작·종료가 같은 제주 현지 Day의 날짜·시간 범위 안인지 검사한다."
}

Table trip_items {
  id uuid [pk]
  trip_plan_id uuid [not null, ref: > trip_plans.id]
  trip_day_id uuid [not null, ref: > trip_days.id]
  schedule_version_id uuid [not null, ref: > trip_schedule_versions.id]
  sequence_no integer [not null]
  item_type text [not null]
  place_id uuid [ref: > tour_places.id]
  title text
  planned_start_at timestamptz
  planned_end_at timestamptz
  stay_minutes integer
  buffer_after_minutes integer [not null]
  required boolean [not null]
  source text [not null]
  memo text
  facts jsonb [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (schedule_version_id, trip_day_id, sequence_no) [unique]
    (id, schedule_version_id) [unique]
    (id, schedule_version_id, trip_plan_id) [unique]
    (id, schedule_version_id, trip_plan_id, trip_day_id) [unique]
  }

  Note: "Immutable after the schedule version leaves draft. Runtime state is stored in trip_item_progress."
}

Table itinerary_generation_runs {
  id uuid [pk]
  trip_plan_id uuid [not null, ref: > trip_plans.id]
  trip_day_id uuid [not null, ref: > trip_days.id]
  base_schedule_version_id uuid [ref: > trip_schedule_versions.id]
  input_mode text [not null]
  status text [not null]
  structured_input jsonb [not null]
  prompt_text text
  contract_version text [not null]
  algorithm_version text [not null]
  model text
  idempotency_key text [not null]
  requested_by_user_id uuid [ref: > user_profiles.id]
  started_at timestamptz
  completed_at timestamptz
  error_code text
  error_message text
  created_at timestamptz [not null]

  indexes {
    (trip_plan_id, idempotency_key) [unique]
    (id, trip_plan_id) [unique]
  }
}

Table schedule_revision_runs {
  id uuid [pk]
  owner_user_id uuid [not null]
  trip_plan_id uuid [not null]
  base_schedule_version_id uuid [not null]
  target_trip_day_id uuid [not null]
  status text [not null, note: "queued|running|succeeded|failed|cancelled"]
  contract_version text [not null]
  algorithm_version text [not null]
  idempotency_key uuid [not null]
  request_hash char(64) [not null, note: "canonical lowercase SHA-256; raw request 미저장"]
  failure_code varchar(100) [note: "retry queued와 failed/cancelled에 필수인 stable nonblank code"]
  attempt_count integer [not null]
  fencing_token bigint [not null]
  lease_owner text
  lease_expires_at timestamptz
  heartbeat_at timestamptz
  next_attempt_at timestamptz
  started_at timestamptz
  completed_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (id, owner_user_id, trip_plan_id, base_schedule_version_id, target_trip_day_id) [unique]
    (owner_user_id, trip_plan_id, idempotency_key) [unique]
    (owner_user_id, trip_plan_id, base_schedule_version_id, target_trip_day_id) [unique, note: "queued/running partial unique"]
  }

  Note: "generation/compute와 분리된 일정 보정 identity/lifecycle 부모. HTTP/input snapshot/MCP call log는 후속 Issue 소유이며 RLS client policy가 없다."
}

Ref: schedule_revision_runs.(trip_plan_id, owner_user_id) > trip_plans.(id, user_id) [delete: cascade]
Ref: schedule_revision_runs.(base_schedule_version_id, trip_plan_id) > trip_schedule_versions.(id, trip_plan_id)
Ref: schedule_revision_runs.(target_trip_day_id, trip_plan_id) > trip_days.(id, trip_plan_id)

Table compute_run_inputs {
  id uuid [pk]
  compute_run_id uuid [ref: > compute_runs.id]
  generation_run_id uuid [ref: > itinerary_generation_runs.id]
  schedule_revision_run_id uuid [ref: > schedule_revision_runs.id]
  owner_user_id uuid [not null]
  trip_plan_id uuid [not null]
  base_schedule_version_id uuid
  run_type varchar(32) [not null]
  schema_version smallint [not null, note: "supported: 1"]
  contract_version varchar(64) [not null]
  algorithm_version varchar(64) [not null]
  structured_input jsonb [not null, note: "canonical object; sensitive/raw location keys forbidden"]
  command_input_hash char(64) [not null, note: "canonical lowercase SHA-256; immutable"]
  location_supplied boolean [not null]
  coarse_location jsonb [note: "GRID_100M|PLACE|STOP closed union"]
  location_precision_meters integer
  location_policy_version varchar(64)
  location_observed_at timestamptz
  location_expires_at timestamptz
  location_redacted_at timestamptz
  created_at timestamptz [not null]

  indexes {
    compute_run_id [unique, note: "partial: non-null"]
    generation_run_id [unique, note: "partial: non-null"]
    schedule_revision_run_id [unique, note: "partial: non-null"]
  }

  Note: "parent exact-one, immutable durable command. 일반 UPDATE 금지; expiry는 restricted monotonic-shortening function만 사용."
}

Ref: compute_run_inputs.(trip_plan_id, owner_user_id) > trip_plans.(id, user_id) [delete: cascade]
Ref: compute_run_inputs.(base_schedule_version_id, trip_plan_id) > trip_schedule_versions.(id, trip_plan_id)

Table itinerary_generation_candidates {
  id uuid [pk]
  trip_plan_id uuid [not null, ref: > trip_plans.id]
  generation_run_id uuid [not null, ref: > itinerary_generation_runs.id]
  schedule_version_id uuid [not null, ref: > trip_schedule_versions.id]
  rank_no integer [not null]
  score integer
  explanation text
  selected_at timestamptz
  created_at timestamptz [not null]

  indexes {
    (generation_run_id, rank_no) [unique]
    (generation_run_id, schedule_version_id) [unique]
  }
}

Table ai_conversations {
  id uuid [pk]
  user_id uuid [not null, ref: > user_profiles.id]
  trip_plan_id uuid [ref: > trip_plans.id]
  status text [not null]
  locale text [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table ai_messages {
  id uuid [pk]
  conversation_id uuid [not null, ref: > ai_conversations.id]
  role text [not null]
  content text [not null]
  structured_payload jsonb [not null]
  generation_run_id uuid [ref: > itinerary_generation_runs.id]
  created_at timestamptz [not null]
}

Table trip_legs {
  id uuid [pk]
  trip_plan_id uuid [not null, ref: > trip_plans.id]
  trip_day_id uuid [not null, ref: > trip_days.id]
  schedule_version_id uuid [not null, ref: > trip_schedule_versions.id]
  sequence_no integer [not null]
  from_item_id uuid [not null, ref: > trip_items.id]
  to_item_id uuid [not null, ref: > trip_items.id]
  transport_mode text [not null, note: "walk, public_transit, rental_car, taxi"]
  origin_stop_id uuid [ref: > bus_stops.id]
  destination_stop_id uuid [ref: > bus_stops.id]
  route_id uuid [ref: > bus_routes.id]
  mobility_route_snapshot_id uuid [ref: > mobility_route_snapshots.id]
  planned_departure_at timestamptz
  planned_arrival_at timestamptz
  walk_minutes integer [not null]
  wait_minutes integer [not null]
  ride_minutes integer [not null]
  transfer_minutes integer [not null]
  duration_minutes integer [note: "must equal arrival-departure and walk+wait+ride+transfer when sealed"]
  buffer_minutes integer [not null]
  distance_meters integer
  estimated_fare integer
  risk_score integer
  facts jsonb [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (schedule_version_id, trip_day_id, sequence_no) [unique]
    (schedule_version_id, from_item_id, to_item_id) [unique]
    (id, schedule_version_id, trip_plan_id) [unique]
    (id, schedule_version_id, trip_plan_id, trip_day_id) [unique]
  }

  Note: "Movement only. From/to items are constrained to the same trip, version and day by composite foreign keys."
}

Table trip_item_progress {
  trip_plan_id uuid [pk, ref: > trip_plans.id]
  schedule_version_id uuid [pk, ref: > trip_schedule_versions.id]
  trip_item_id uuid [pk, ref: > trip_items.id]
  status text [not null]
  actual_started_at timestamptz
  actual_arrived_at timestamptz
  actual_completed_at timestamptz
  updated_at timestamptz [not null]
}

Table trip_execution_events {
  id uuid [pk]
  trip_plan_id uuid [not null, ref: > trip_plans.id]
  schedule_version_id uuid [not null, ref: > trip_schedule_versions.id]
  trip_item_id uuid [ref: > trip_items.id]
  trip_leg_id uuid [ref: > trip_legs.id]
  event_type text [not null]
  client_event_id text [not null]
  location geography
  occurred_at timestamptz [not null]
  recorded_at timestamptz [not null]
  metadata jsonb [not null]

  indexes {
    (trip_plan_id, client_event_id) [unique]
  }

  Note: "Append-only runtime audit."
}

Table compute_runs {
  id uuid [pk]
  trip_plan_id uuid [not null, ref: > trip_plans.id]
  trip_day_id uuid [ref: > trip_days.id]
  schedule_version_id uuid [not null, ref: > trip_schedule_versions.id]
  run_type text [not null]
  status text [not null]
  input_hash text [not null]
  contract_version text [not null]
  algorithm_version text [not null]
  facts_snapshot_at timestamptz
  source_data_version text
  result_source text
  result_summary jsonb [not null]
  started_at timestamptz
  completed_at timestamptz
  error_code text
  error_message text
  attempt_count integer [not null]
  fencing_token bigint [not null]
  lease_owner text
  lease_expires_at timestamptz
  heartbeat_at timestamptz
  next_attempt_at timestamptz
  created_at timestamptz [not null]

  indexes {
    (id, trip_plan_id, schedule_version_id) [unique]
    (id, trip_plan_id, schedule_version_id, trip_day_id) [unique]
    (schedule_version_id, run_type, input_hash, algorithm_version) [unique]
  }
}

Table risk_events {
  id uuid [pk]
  trip_plan_id uuid [not null, ref: > trip_plans.id]
  schedule_version_id uuid [not null, ref: > trip_schedule_versions.id]
  compute_run_id uuid [not null, ref: > compute_runs.id]
  trip_item_id uuid [ref: > trip_items.id]
  trip_leg_id uuid [ref: > trip_legs.id]
  event_type text [not null]
  severity text [not null]
  score_delta integer [not null]
  wait_risk_minutes integer
  reason_code text [not null]
  computed_facts jsonb [not null]
  created_at timestamptz [not null]

  indexes {
    (id, trip_plan_id, schedule_version_id) [unique]
  }
}

Table trip_weather_impacts {
  id uuid [pk]
  trip_plan_id uuid [not null, ref: > trip_plans.id]
  trip_day_id uuid [note: "legacy NULL 보존; 신규 INSERT는 필수; (trip_day_id,trip_plan_id) 복합 FK"]
  schedule_version_id uuid [not null, ref: > trip_schedule_versions.id]
  compute_run_id uuid [not null]
  trip_item_id uuid
  trip_leg_id uuid
  weather_forecast_id uuid [ref: > weather_forecasts.id]
  weather_observation_id uuid [ref: > weather_observations.id]
  impact_type text [not null]
  severity text [not null]
  score_delta integer [not null]
  recommendation_text text
  computed_facts jsonb [not null]
  created_at timestamptz [not null]

  Note: "legacy NULL-Day 행은 compute/item/leg 부모 계보가 동결된다. trip_day_id와 같은 Day의 부모를 한 번에 지정하는 명시적 repair만 허용한다."
}

Table recommendation_candidates {
  id uuid [pk]
  trip_plan_id uuid [not null, ref: > trip_plans.id]
  trip_day_id uuid [note: "legacy NULL 보존; 신규 INSERT는 필수; (trip_day_id,trip_plan_id) 복합 FK"]
  schedule_version_id uuid [not null, ref: > trip_schedule_versions.id]
  compute_run_id uuid [not null]
  base_item_id uuid
  candidate_place_id uuid [not null, ref: > tour_places.id]
  recommendation_type text [not null]
  available_gap_minutes integer
  required_total_minutes integer
  travel_minutes integer
  stay_minutes integer
  safety_buffer_minutes integer [not null]
  score integer
  reason_code text
  facts jsonb [not null]
  created_at timestamptz [not null]

  Note: "legacy NULL-Day 행은 compute/base item 부모 계보가 동결된다. trip_day_id와 같은 Day의 부모를 한 번에 지정하는 명시적 repair만 허용한다."
}

Ref: trip_weather_impacts.(compute_run_id, trip_plan_id, schedule_version_id, trip_day_id) > compute_runs.(id, trip_plan_id, schedule_version_id, trip_day_id) [delete: cascade]
Ref: trip_weather_impacts.(trip_day_id, trip_plan_id) > trip_days.(id, trip_plan_id) [delete: cascade]
Ref: trip_weather_impacts.(trip_item_id, schedule_version_id, trip_plan_id, trip_day_id) > trip_items.(id, schedule_version_id, trip_plan_id, trip_day_id) [delete: cascade]
Ref: trip_weather_impacts.(trip_leg_id, schedule_version_id, trip_plan_id, trip_day_id) > trip_legs.(id, schedule_version_id, trip_plan_id, trip_day_id) [delete: cascade]
Ref: recommendation_candidates.(compute_run_id, trip_plan_id, schedule_version_id, trip_day_id) > compute_runs.(id, trip_plan_id, schedule_version_id, trip_day_id) [delete: cascade]
Ref: recommendation_candidates.(trip_day_id, trip_plan_id) > trip_days.(id, trip_plan_id) [delete: cascade]
Ref: recommendation_candidates.(base_item_id, schedule_version_id, trip_plan_id, trip_day_id) > trip_items.(id, schedule_version_id, trip_plan_id, trip_day_id)

Table recovery_options {
  id uuid [pk]
  trip_plan_id uuid [not null, ref: > trip_plans.id]
  compute_run_id uuid [not null, ref: > compute_runs.id]
  trigger_risk_event_id uuid [ref: > risk_events.id]
  base_schedule_version_id uuid [not null, ref: > trip_schedule_versions.id]
  proposed_schedule_version_id uuid [not null, ref: > trip_schedule_versions.id]
  option_type text [not null, note: 'take_next_bus | move_to_another_day | replace_place | shorten_stay | skip_optional | change_transport; automatic reorder is excluded']
  status text [not null]
  title text [not null]
  explanation text
  impact_minutes integer [not null]
  resulting_score integer
  change_summary jsonb [not null]
  expires_at timestamptz
  selected_at timestamptz
  applied_at timestamptz
  created_at timestamptz [not null]

  indexes {
    (id, base_schedule_version_id, proposed_schedule_version_id) [unique]
  }
}

Table recovery_option_changes {
  id uuid [pk]
  recovery_option_id uuid [not null, ref: > recovery_options.id]
  base_schedule_version_id uuid [not null, ref: > trip_schedule_versions.id]
  proposed_schedule_version_id uuid [not null, ref: > trip_schedule_versions.id]
  change_order integer [not null]
  action text [not null, note: 'add | remove | move_day | update_time | shorten_stay | change_transport; automatic reorder is excluded']
  source_item_id uuid [ref: > trip_items.id]
  proposed_item_id uuid [ref: > trip_items.id]
  before_value jsonb [not null]
  after_value jsonb [not null]
  reason_code text [not null]
  created_at timestamptz [not null]

  indexes {
    (recovery_option_id, change_order) [unique]
  }
}

Table live_state_snapshots {
  id uuid [pk]
  trip_plan_id uuid [not null, ref: > trip_plans.id]
  schedule_version_id uuid [not null, ref: > trip_schedule_versions.id]
  active_item_id uuid [ref: > trip_items.id]
  active_leg_id uuid [ref: > trip_legs.id]
  compute_run_id uuid [ref: > compute_runs.id]
  status text [not null]
  current_location geography
  current_place_id uuid [ref: > tour_places.id]
  next_action text
  observed_at timestamptz [not null]
  facts jsonb [not null]
}

Table mcp_compute_call_logs {
  id uuid [pk]
  user_id uuid [ref: > user_profiles.id]
  trip_plan_id uuid [ref: > trip_plans.id]
  compute_run_id uuid [ref: > compute_runs.id]
  generation_run_id uuid [ref: > itinerary_generation_runs.id]
  schedule_revision_run_id uuid [ref: > schedule_revision_runs.id]
  request_id text [not null]
  tool_name text [not null]
  status text [not null]
  contract_version text [not null]
  command_input_hash char(64)
  mcp_input_hash char(64)
  schema_checksum char(64)
  request_fact_count integer
  response_fact_count integer
  attempt_no integer [not null]
  legacy_contract boolean [not null]
  latency_ms integer
  error_code text
  created_at timestamptz [not null]

  indexes {
    (request_id, tool_name, attempt_no) [unique]
  }
}

  source_snapshot_id uuid [ref: > external_api_snapshots.id]
  confidence numeric [not null]
  stale boolean [not null]
  last_seen_at timestamptz [not null]
  stale_at timestamptz
  tombstoned_at timestamptz
  source_deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (source_provider, source_service, city_code, external_route_id) [unique, note: "external_route_id가 있을 때 적용"]
  }

  Note: "v1 빈 external/provider 값은 보존하지만 신규/변경에는 nonblank provider/service/external key가 적용된다."
}

Table route_stops {
  route_id uuid [pk, ref: > bus_routes.id]
  stop_id uuid [not null, ref: > bus_stops.id]
  direction_key text [pk]
  stop_sequence integer [pk]
  travel_minutes_from_prev integer
  source_provider text [not null]
  city_code text [not null]
  import_run_id uuid [ref: > data_import_runs.id]
  source_snapshot_id uuid [ref: > external_api_snapshots.id]
  last_seen_at timestamptz [not null]
  stale_at timestamptz
  tombstoned_at timestamptz

  indexes {
    (route_id, direction_key, stop_id) [unique]
  }

  Note: "route_id/stop_id UUID FK가 존재와 삭제 전파를 보장하고 trigger가 route·stop과 같은 source_provider/city인지 잠금 검증한다. legacy 빈 provider·불일치는 보존하되 신규/변경 및 정상 lineage repair에는 엄격히 적용한다."
}

Table timetable_entries {
  id uuid [pk]
  route_id uuid [not null, ref: > bus_routes.id]
  stop_id uuid [not null, ref: > bus_stops.id]
  direction_key text [not null]
  service_day_type text [not null]
  departure_time time [not null]
  trip_key text
  source_record_key text [not null]
  valid_from date [not null, note: "기본값 -infinity"]
  valid_to date
  source_provider text [not null]
  source_service text [not null]
  city_code text [note: "legacy 경유 누락/provider 불일치는 NULL 보존; 신규/변경은 필수"]
  import_run_id uuid [ref: > data_import_runs.id]
  source_snapshot_id uuid [ref: > external_api_snapshots.id]
  confidence numeric [not null]
  stale boolean [not null]
  last_seen_at timestamptz [not null]
  stale_at timestamptz
  tombstoned_at timestamptz
  created_at timestamptz [not null]

  indexes {
    (source_provider, source_service, city_code, source_record_key, valid_from) [unique]
  }

  Note: "(route_id,direction_key,stop_id) 3열 FK가 route_stop 존재를 보장하고 trigger가 provider/city까지 잠금 검증한다. legacy city NULL은 NOT VALID로 보존하며 같은 source record 유효기간은 겹칠 수 없다."
}

Table tago_arrival_flights {

  location geography [not null]
  source_provider text [not null]
  source_service text [not null]
  city_code text [not null]
  import_run_id uuid [ref: > data_import_runs.id]
  source_snapshot_id uuid [ref: > external_api_snapshots.id]
  confidence numeric [not null]
  stale boolean [not null]
  last_seen_at timestamptz [not null]
  stale_at timestamptz
  tombstoned_at timestamptz
  source_deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (source_provider, source_service, city_code, node_id) [unique]
    (source_provider, source_service, city_code, external_stop_id) [unique, note: "external_stop_id가 있을 때 적용"]
  }

  Note: "v1 빈 external/provider 값은 보존하지만 신규/변경에는 nonblank provider/service/external key가 적용된다."
}

Table place_stop_links {

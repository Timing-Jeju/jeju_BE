  generation bigint [not null]
  owner_token uuid [not null]
  lease_expires_at timestamptz [not null]
  state text [not null, note: "running|succeeded|failed|abandoned"]
  outcome_code text [note: "bounded TAGO arrival domain code only"]
  retain_until timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (retain_until, fingerprint) [name: 'idx_tago_arrival_flights_cleanup']
  }
}

Table bus_arrival_snapshots {

  lcls_systm2 text [note: "KorService2 lclsSystm2 원문 분류 코드"]
  lcls_systm3 text [note: "KorService2 lclsSystm3 원문 분류 코드"]
  source_snapshot_id uuid [ref: > external_api_snapshots.id]

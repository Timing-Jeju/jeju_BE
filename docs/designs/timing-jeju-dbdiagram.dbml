Project timing_jeju_v1_2 {
  database_type: "PostgreSQL"
  note: "Supabase Auth + Postgres/PostGIS. 적용된 migration은 수정하지 않고 더 큰 timestamp migration만 추가한다. 외부 정규화 행은 parsed/tombstoned 원문과 같은 run·scope를 필수로 유지한다. manual/fixture/admin은 이전·새 행이 모두 예외일 때 편집 가능하고 외부 legacy 행은 예외 marker로 우회할 수 없다. migration canonical order는 stop-import `/016`, #36 route `/017`, #76 KMA(optional) `/018`, #37 place-link `/020`, #65 stay-policy `/021`, #39 arrival `/024`, #39 flight-state `/025`, #160 completed-health index `/026`, #164 snapshot retention index `/027`, seed `/099`를 기준으로 정렬한다."
}

Table auth.users {
  id uuid [pk]
  email text [unique]
  raw_app_meta_data jsonb
  raw_user_meta_data jsonb
  created_at timestamptz
  updated_at timestamptz
  last_sign_in_at timestamptz
}

Table data_import_runs {
  id uuid [pk]
  source_kind text [not null]
  source_name text [not null]
  source_provider text [not null]
  source_service text [not null]
  source_operation text [not null]
  data_version text [not null]
  parser_version text [not null]
  schema_version text [not null]
  sync_mode text [not null, note: "full, incremental, lazy, snapshot"]
  scope_key text [not null]
  request_fingerprint text
  idempotency_key text
  idempotency_enforced boolean [not null, note: "신규 true 고정; legacy 멱등 중복은 가장 오래된 canonical만 true"]
  running_scope_enforced boolean [not null, note: "신규 true 고정; grandfathered running 범위의 새 run은 trigger가 23505"]
  parent_run_id uuid [ref: > data_import_runs.id]
  checkpoint_before jsonb [not null]
  checkpoint_after jsonb [not null]
  status text [not null, note: "running, succeeded, failed, partial, cancelled; 같은 provider/service/operation/scope의 running은 1건"]
  started_at timestamptz [not null]
  finished_at timestamptz
  row_count integer [not null]
  retry_count integer [not null]
  fetched_count integer [not null]
  inserted_count integer [not null]
  updated_count integer [not null]
  skipped_count integer [not null]
  rejected_count integer [not null]
  deleted_count integer [not null]
  staled_count integer [not null]
  error_code text
  error_message text
  metadata jsonb [not null]

  indexes {
    (source_provider, source_service, source_operation, scope_key, idempotency_key) [unique, note: "idempotency_key IS NOT NULL AND idempotency_enforced; ON CONFLICT arbiter"]
    (source_provider, source_service, source_operation, scope_key) [unique, note: "status=running AND running_scope_enforced; grandfathered false 범위는 BEFORE trigger로도 차단"]
    (source_provider, source_service, source_operation, started_at, id) [name: 'idx_data_import_runs_completed_health_latest', note: "DESC started_at/id; terminal completed canonical runs only; INCLUDE status,finished_at"]
  }

  Note: "idempotency canonical true 행은 같은 키의 grandfathered false 행이 남아 있으면 선삭제할 수 없다. running marker는 ON CONFLICT arbiter나 canonical 삭제 보호가 아니며 동일 범위 신규/재시작을 직접 거부한다."
}

Table data_import_checkpoints {
  id uuid [pk]
  source_provider text [not null]
  source_service text [not null]
  source_operation text [not null]
  scope_key text [not null]
  checkpoint jsonb [not null]
  source_watermark_at timestamptz
  last_succeeded_run_id uuid [ref: > data_import_runs.id]
  version bigint [not null]
  updated_at timestamptz [not null]

  indexes {
    (source_provider, source_service, source_operation, scope_key) [unique]
  }

  Note: "last_succeeded_run_id는 UUID FK이고 trigger가 같은 source scope의 succeeded run인지 양방향으로 검증한다. 두 guard 설치 후 기존 참조도 소급 감사한다. service_role 전용 advance_data_import_checkpoint(expected version) CAS로만 전진하며 stale writer는 40001, 직접 UPDATE/DELETE/TRUNCATE·scope 변경·이전 run 역행은 금지한다."
}

Table external_api_snapshots {
  id uuid [pk]
  import_run_id uuid [not null, ref: > data_import_runs.id]
  source_provider text [not null]
  source_service text [not null]
  source_operation text [not null]
  scope_key text [not null]
  external_record_id text
  request_hash text [not null, note: "SHA-256 소문자 hex"]
  page_key text [not null]
  http_status integer
  provider_result_code text
  fetched_at timestamptz [not null]
  source_modified_at timestamptz
  expires_at timestamptz
  parser_version text [not null]
  payload_hash text [not null, note: "SHA-256 소문자 hex"]
  parse_status text [not null, note: "received, parsed, rejected, ignored, tombstoned"]
  parsed_at timestamptz
  error_code text
  error_message text
  request_metadata_redacted jsonb [not null]
  raw_payload jsonb
  purge_after timestamptz
  purged_at timestamptz

  indexes {
    (import_run_id, source_operation, request_hash, page_key, payload_hash) [unique]
    (purge_after, id) [note: "partial: purge_after IS NOT NULL AND purged_at IS NULL AND raw_payload IS NOT NULL"]
  }

  Note: "import_run_id는 UUID FK이고 trigger가 한 run에 정확히 하나의 provider/service/operation/scope만 허용한다. 기존 다중 scope는 식별자와 함께 중단한다. run/source identity와 request·parser·payload 감사 필드는 불변이며 parsed/tombstoned 상태를 미파싱 상태로 되돌릴 수 없다. retention은 due payload의 raw_payload만 NULL, purged_at만 now로 바꾸며 row/run/normalized lineage를 보존한다."
}


#!/bin/bash
set -eu
umask 077
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq docker.io python3 ca-certificates
systemctl enable --now docker
cat > /usr/local/sbin/timing-jeju-metadata-guard <<'SH'
#!/bin/sh
set -eu
# Container workloads cannot acquire the VM service-account token through metadata.
# The same address is the VPC DNS resolver Docker hands to containers, so keep port 53 open.
for protocol in tcp udp; do
  iptables -C DOCKER-USER -d 169.254.169.254/32 -p "$protocol" ! --dport 53 -j REJECT 2>/dev/null ||
    iptables -I DOCKER-USER 1 -d 169.254.169.254/32 -p "$protocol" ! --dport 53 -j REJECT
done
SH
chmod 0700 /usr/local/sbin/timing-jeju-metadata-guard
/usr/local/sbin/timing-jeju-metadata-guard
cat > /usr/local/sbin/timing-jeju-prepare <<'PY'
#!/usr/bin/python3
import base64
import json
import os
import pathlib
import re
import subprocess
import sys
import urllib.request
import urllib.parse

def request_json(url, headers):
    request = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.load(response)

def main():
    root = pathlib.Path('/run/timing-jeju')
    root.mkdir(mode=0o700, exist_ok=True)
    secrets = root / 'secrets'
    secrets.mkdir(mode=0o700, exist_ok=True)
    environment_dir = root / 'config'
    environment_dir.mkdir(mode=0o700, exist_ok=True)
    # Image digest, secret versions and hosts are instance metadata, re-read on every start,
    # so Terraform updates them in place instead of recreating the VM.
    config = request_json('http://metadata.google.internal/computeMetadata/v1/instance/attributes/timing-jeju-config', {'Metadata-Flavor': 'Google'})
    token = request_json('http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token', {'Metadata-Flavor': 'Google'})['access_token']
    def fetch(ref):
        url = 'https://secretmanager.googleapis.com/v1/projects/' + config['project'] + '/secrets/' + ref['secret_id'] + '/versions/' + ref['version'] + ':access'
        return base64.b64decode(request_json(url, {'Authorization': 'Bearer ' + token})['payload']['data'], validate=True)
    # Fetch and validate every payload before replacing any mounted file.
    environment = fetch(config['environment'])
    if b'\x00' in environment or b'\r' in environment:
        raise ValueError('invalid environment')
    entries = {}
    for line in environment.decode('utf-8').splitlines():
        if not line or line.startswith('#'):
            continue
        key, sep, value = line.partition('=')
        if not sep or key in entries or not re.fullmatch(r'[A-Z][A-Z0-9_]*', key):
            raise ValueError('invalid environment')
        entries[key] = value
    required = ['SPRING_DATASOURCE_URL', 'SPRING_DATASOURCE_USERNAME', 'SPRING_DATASOURCE_PASSWORD', 'SUPABASE_JWT_ISSUER', 'SUPABASE_JWKS_URL', 'APP_CORS_ALLOWED_ORIGINS', 'APP_PLACES_CURSOR_SIGNING_KEY', 'APP_TRIPS_CURSOR_SIGNING_KEY']
    if any(not entries.get(key) for key in required):
        raise ValueError('missing required configuration')
    jdbc = entries['SPRING_DATASOURCE_URL']
    query = urllib.parse.parse_qs(urllib.parse.urlsplit(jdbc.removeprefix('jdbc:')).query)
    if not jdbc.startswith('jdbc:postgresql://') or query.get('sslmode') != ['verify-full']:
        raise ValueError('database TLS verification required')
    payloads = {name: fetch(ref) for name, ref in config['files'].items()}
    for name, payload in payloads.items():
        path = secrets / name
        path.write_bytes(payload)
        path.chmod(0o600)
        os.chown(path, 10001, 10001)
    os.chown(secrets, 10001, 10001)
    # Explicit application.yml placeholders read these keys from configtree.
    # Do not use Docker --env-file: Docker persists those values in container metadata.
    for key, value in entries.items():
        path = environment_dir / key
        path.write_text(value)
        path.chmod(0o600)
        os.chown(path, 10001, 10001)
    # Framework properties are not application.yml placeholders: map explicitly.
    for key, property_name in {
        'SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE': 'spring.datasource.hikari.maximum-pool-size',
        'SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE': 'spring.datasource.hikari.minimum-idle',
    }.items():
        if key in entries:
            path = environment_dir / property_name
            path.write_text(entries[key])
            path.chmod(0o600)
            os.chown(path, 10001, 10001)
    os.chown(environment_dir, 10001, 10001)
    docker_config = root / 'docker'
    docker_config.mkdir(mode=0o700, exist_ok=True)
    process_env = dict(os.environ, DOCKER_CONFIG=str(docker_config))
    try:
        subprocess.run(['docker', 'login', '--username', 'oauth2accesstoken', '--password-stdin', config['registry']], input=token.encode(), env=process_env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
        subprocess.run(['docker', 'pull', config['image']], env=process_env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
    finally:
        (docker_config / 'config.json').unlink(missing_ok=True)
    # The run step must start exactly the configuration validated above.
    snapshot = root / 'runtime.json'
    snapshot.write_text(json.dumps(config))
    snapshot.chmod(0o600)

try:
    main()
except Exception:
    # Never log provider bodies, tokens, environment or exception strings.
    print('BE startup preparation failed; container was not started.', file=sys.stderr)
    sys.exit(1)
PY
chmod 0700 /usr/local/sbin/timing-jeju-prepare
cat > /usr/local/sbin/timing-jeju-run <<'PY'
#!/usr/bin/python3
import json
import os
import pathlib
config = json.loads(pathlib.Path('/run/timing-jeju/runtime.json').read_text())
hosts = [arg for host, ip in config['hosts'].items() for arg in ['--add-host', host + ':' + ip]]
os.execvp('docker', ['docker', 'run', '--rm', '--name=timing-jeju-be', '--log-driver=none', '--read-only', '--cap-drop=ALL', '--security-opt=no-new-privileges', '--user=10001:10001', '--memory=5g', '--cpus=2', '--pids-limit=256', '--tmpfs=/tmp:rw,noexec,nosuid,size=256m', '--env=SPRING_CONFIG_IMPORT=configtree:/run/config/', '--env=SPRING_PROFILES_ACTIVE=production', '--env=SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=210s', '--env=SPRINGDOC_API_DOCS_ENABLED=false', '--env=SPRINGDOC_SWAGGER_UI_ENABLED=false', '--mount=type=bind,src=/run/timing-jeju/config,dst=/run/config,readonly', '--mount=type=bind,src=/run/timing-jeju/secrets,dst=/run/secrets,readonly', '-p', '8080:8080'] + hosts + [config['image']])
PY
chmod 0700 /usr/local/sbin/timing-jeju-run
cat > /etc/systemd/system/timing-jeju-be.service <<'UNIT'
[Unit]
Description=Timing Jeju Spring API and durable generation worker
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
PartOf=docker.service
StartLimitIntervalSec=0

[Service]
Type=simple
UMask=0077
RuntimeDirectory=timing-jeju
RuntimeDirectoryMode=0700
ExecStartPre=-/usr/bin/docker rm -f timing-jeju-be
ExecStartPre=/usr/local/sbin/timing-jeju-metadata-guard
ExecStartPre=/usr/local/sbin/timing-jeju-prepare
ExecStart=/usr/local/sbin/timing-jeju-run
ExecStop=/usr/bin/docker stop --time=240 timing-jeju-be
TimeoutStartSec=600
TimeoutStopSec=270
Restart=always
RestartSec=30
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target docker.service
UNIT
systemctl daemon-reload
systemctl enable timing-jeju-be.service
systemctl restart timing-jeju-be.service
